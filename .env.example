# Optional custom PeerJS signaling server (default: PeerJS Cloud)
# NEXT_PUBLIC_PEER_HOST=peerjs.example.com
# NEXT_PUBLIC_PEER_PORT=443
# NEXT_PUBLIC_PEER_PATH=/myapp
# NEXT_PUBLIC_PEER_SECURE=true

# Optional TURN servers (comma-separated URLs, plus credentials)
# NEXT_PUBLIC_TURN_URLS=turn:global.relay.metered.ca:80,turn:global.relay.metered.ca:443
# NEXT_PUBLIC_TURN_USERNAME=openrelayproject
# NEXT_PUBLIC_TURN_CREDENTIAL=openrelayproject
